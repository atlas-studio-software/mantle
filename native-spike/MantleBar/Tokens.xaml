<?xml version="1.0" encoding="utf-8"?>
<!--
  The island theme, copied from ui/shared/glass-light.css (the one theme every Mantle surface uses).
  Same names as the CSS custom properties (Lg* = -lg-*), so a migration can map them one to one.
  The CSS rgba(r,g,b,a) values become #AARRGGBB with a = round(a * 255).
  Light is :root, Dark is :root[data-theme="dark"]. bar.css rules that differ in dark are here too
  (pill radius 18, the bar's own .50 wash, 13 px type, a 12 px date).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- -lg-fill .45 over the blurred backdrop; -lg-fill-fb .62 when there is no backdrop -->
      <SolidColorBrush x:Key="LgPaneFill" Color="#73FFFFFF"/>
      <SolidColorBrush x:Key="LgPaneFillFallback" Color="#9EFFFFFF"/>
      <SolidColorBrush x:Key="LgEdgeOut" Color="#1A0B0E1A"/>
      <SolidColorBrush x:Key="LgLip" Color="#9EFFFFFF"/>
      <SolidColorBrush x:Key="LgInk" Color="#FF0B0E1A"/>
      <SolidColorBrush x:Key="LgInk2" Color="#FF333A4E"/>
      <SolidColorBrush x:Key="LgInk3" Color="#FF5B6478"/>
      <SolidColorBrush x:Key="LgAcc" Color="#FF4436E8"/>
      <SolidColorBrush x:Key="LgAccSoft" Color="#1F4436E8"/>
      <SolidColorBrush x:Key="LgHover" Color="#0F0B0E1A"/>
      <SolidColorBrush x:Key="LgPress" Color="#1A0B0E1A"/>
      <SolidColorBrush x:Key="LgTile" Color="#140B0E1A"/>
      <CornerRadius x:Key="LgPillCorner">24</CornerRadius>
      <CornerRadius x:Key="LgLipCorner">23</CornerRadius>
      <x:Double x:Key="LgBodySize">12.5</x:Double>
      <x:Double x:Key="LgDateSize">12.5</x:Double>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- the bar's own wash (-lg-fill-bar .50); its fallback is -lg-fill .83 -->
      <SolidColorBrush x:Key="LgPaneFill" Color="#80090A0B"/>
      <SolidColorBrush x:Key="LgPaneFillFallback" Color="#D4131415"/>
      <SolidColorBrush x:Key="LgEdgeOut" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="LgLip" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="LgInk" Color="#FFECECEA"/>
      <SolidColorBrush x:Key="LgInk2" Color="#FFA9AAA7"/>
      <SolidColorBrush x:Key="LgInk3" Color="#FF75767A"/>
      <SolidColorBrush x:Key="LgAcc" Color="#FF9FB4CC"/>
      <SolidColorBrush x:Key="LgAccSoft" Color="#249FB4CC"/>
      <SolidColorBrush x:Key="LgHover" Color="#9E28292B"/>
      <SolidColorBrush x:Key="LgPress" Color="#9E3E3F42"/>
      <SolidColorBrush x:Key="LgTile" Color="#9E28292B"/>
      <CornerRadius x:Key="LgPillCorner">18</CornerRadius>
      <CornerRadius x:Key="LgLipCorner">17</CornerRadius>
      <x:Double x:Key="LgBodySize">13</x:Double>
      <x:Double x:Key="LgDateSize">12</x:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="LgFont">Segoe UI Variable Text, Segoe UI</FontFamily>
</ResourceDictionary>
