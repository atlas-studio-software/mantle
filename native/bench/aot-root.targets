<Project>
  <!--
    aot-root.targets - imported ONLY by run-bench.ps1 -Mode modes, build mode "aot-json", through
    -p:CustomAfterMicrosoftCommonTargets=<this file> on the dotnet publish command line. It is a bench
    workaround, not a fix, and it never lands in the app's project.

    The app writes ready.json / cells.json with System.Text.Json reflection over anonymous types. A trimmed
    or Native AOT build turns reflection serialization off (JsonSerializerIsReflectionEnabledByDefault=false)
    and trims the anonymous types' getters, so the writes fail and the bench loses its first-frame mark and
    the dock cells it clicks. This roots the app's own assembly (every type and member kept and compiled),
    which, with -p:JsonSerializerIsReflectionEnabledByDefault=true, lets those writes work under AOT.
    The real fix is in the app (see native/bench/README.md): a JsonSerializerContext, or Utf8JsonWriter.
  -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>
</Project>
