<?xml version="1.0" encoding="utf-8"?>
<!--
  The levitated look's tokens (lane r10-newlook; owner's decision 2026-11-24, EM ticket t_c268b8: Quartz's "levitated"
  look is Mantle's look), from the design file LOOK.md (look-sync design commit 97aa001), which replaced the first spec
  (the prototype quartz-home/app.js + style.css). Merged once, by Theme/Theme.xaml, after Tokens.xaml. The same in both
  themes (but the bar's islands inks, LvBar*, in ThemeDictionaries). Hand-written; its C# mirror for the pure code is Mantle.Core/Look/Levitate/LevitateTokens.cs, and
  LevitateTokensTests holds the two equal. Tokens.xaml's values (the other surfaces) are not changed by this file.
  Everything floats above the wallpaper with gaps; nothing but the picture touches the screen edges. Island edge: none
  (no hairline, ring or top highlight); no tint film, no frost colour, no white sheen at rest (LvSheenHover is hover only);
  one neutral family, one accent; no gradients, no glow at rest.
  rgba(r,g,b,a) is #AARRGGBB with a = round(a * 255), as in Tokens.xaml. Colour literals are allowed here (the
  second token file, TokensTests' lint).
  Not here (the WinUI layer draws them from the C# mirror): the float / float-hi / sheet / text shadows, the dim wash
  and the legibility film (their alphas are computed), the blurred copies of the still, the font weights.
  The type SCALE is not set by LOOK.md: Tokens.xaml's native scale stays; only the two families are here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- lane r14-bar-review, completed by lane r15-bar-light: the bar's islands inks, the one part of this file that differs
       by theme (apps-r3/mantle-bar look.css; light from apps-r3/LIGHT.md 4, 4.1 and 4.2). Only the islands look uses them
       (BarGeometry.Islands: the bar's three islands and the bar pop-ups that wear the levitated look, Downloads today);
       the MANTLE_TEST_GLASS=electron face keeps Tokens.xaml's Lg* inks. Every Dark value is the one the islands showed
       before lane r15 (the LOOK.md tokens below, or the Lg token a part kept), so dark does not change.
       rgba(r,g,b,a) is #AARRGGBB with a = round(a * 255); the light ink is #0F1E21 (one neutral family).
       LvBarInk: every glyph on the bar and the main text (look.css .btn { color: the text token }): dark #EEF6F7, light
         #0F1E21.
       LvBarInk2 / LvBarInk3 / LvBarInk4: text-2 / -3 / -4 (the date, the More pip for a plain problem, secondary lines,
         hints, disabled): dark rgba(230,242,244,.76 / .54 / .34), light #0F1E21 at .76 / .56 / .36.
       LvBarWarn: the warn token, only for a "warn" problem: dark #E3C47E, light #4C3300.
       LvBarOk / LvBarDown: gain / loss: dark #8FE3B4 / #FF9D95, light #124028 / #6F1813.
       LvBarFillHover / LvBarFillOn / LvBarFillStrong / LvBarFillPressed: control fills inside an island: dark white
         .07 / .12 / .18, pressed .05; light black .05 / .08 / .12, pressed .04.
       LvBarHair: the dividers INSIDE an island (the status island's and the dock's separators, a pop-up's foot line):
         dark white .09, light black .08.
       LvBarSheen / LvBarSheenBig: the island's white sheen on HOVER only (LevitatePanel): dark .07 / .05 (LevitateTokens'
         SheenHover / SheenHoverBig), light .16 / .12 (a hovered light island lifts a little more).
       LvBarRun: the dock's running dot (look.css .cell .run: text-3): dark keeps LgInk2's #A9AAA7, light #0F1E21 at .56.
       LvBarTile / LvBarTileInk: a dock cell's letter tile and its letter, the media chip's art tile (look.css .app-ic:
         fill-2, the text ink): dark keeps LgTile / LgInk, light black .08 / #0F1E21.
       LvBarSunk: the dock's "+N" button at rest: dark keeps LgSunk, light black .05 (fill-1).
       LvBarAccent / LvBarAccentHover / LvBarAccentInk: the islands accent (the dock's focus underline, the downloads
         dot, the bell's count badge): dark #A9E7ED / #C4F0F4 / #052A2F, which the code takes from Mantle.Core Accent's
         "islands" profile (these Dark values are its mirror, BarLightTokensTests holds them equal); light #083F49 /
         hover #05313A / ink #F4F7F8 (LIGHT.md 4 and 4.2), a local brush until Core's islands light (look-sync v2.2) is
         ported. Not drawn: the island text shadow (light 0 1px 1px rgba(255,255,255,.28)); native draws no text shadows
         on the islands in either theme. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="LvBarInk" Color="#FFEEF6F7"/>
      <SolidColorBrush x:Key="LvBarInk2" Color="#C2E6F2F4"/>
      <SolidColorBrush x:Key="LvBarInk3" Color="#8AE6F2F4"/>
      <SolidColorBrush x:Key="LvBarInk4" Color="#57E6F2F4"/>
      <SolidColorBrush x:Key="LvBarWarn" Color="#FFE3C47E"/>
      <SolidColorBrush x:Key="LvBarOk" Color="#FF8FE3B4"/>
      <SolidColorBrush x:Key="LvBarDown" Color="#FFFF9D95"/>
      <SolidColorBrush x:Key="LvBarFillHover" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="LvBarFillOn" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="LvBarFillStrong" Color="#2EFFFFFF"/>
      <SolidColorBrush x:Key="LvBarFillPressed" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="LvBarHair" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="LvBarSheen" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="LvBarSheenBig" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="LvBarRun" Color="#FFA9AAA7"/>
      <SolidColorBrush x:Key="LvBarTile" Color="#9E28292B"/>
      <SolidColorBrush x:Key="LvBarTileInk" Color="#FFECECEA"/>
      <SolidColorBrush x:Key="LvBarSunk" Color="#750A0B0C"/>
      <SolidColorBrush x:Key="LvBarAccent" Color="#FFA9E7ED"/>
      <SolidColorBrush x:Key="LvBarAccentHover" Color="#FFC4F0F4"/>
      <SolidColorBrush x:Key="LvBarAccentInk" Color="#FF052A2F"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="LvBarInk" Color="#FF0F1E21"/>
      <SolidColorBrush x:Key="LvBarInk2" Color="#C20F1E21"/>
      <SolidColorBrush x:Key="LvBarInk3" Color="#8F0F1E21"/>
      <SolidColorBrush x:Key="LvBarInk4" Color="#5C0F1E21"/>
      <SolidColorBrush x:Key="LvBarWarn" Color="#FF4C3300"/>
      <SolidColorBrush x:Key="LvBarOk" Color="#FF124028"/>
      <SolidColorBrush x:Key="LvBarDown" Color="#FF6F1813"/>
      <SolidColorBrush x:Key="LvBarFillHover" Color="#0D000000"/>
      <SolidColorBrush x:Key="LvBarFillOn" Color="#14000000"/>
      <SolidColorBrush x:Key="LvBarFillStrong" Color="#1F000000"/>
      <SolidColorBrush x:Key="LvBarFillPressed" Color="#0A000000"/>
      <SolidColorBrush x:Key="LvBarHair" Color="#14000000"/>
      <SolidColorBrush x:Key="LvBarSheen" Color="#29FFFFFF"/>
      <SolidColorBrush x:Key="LvBarSheenBig" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="LvBarRun" Color="#8F0F1E21"/>
      <SolidColorBrush x:Key="LvBarTile" Color="#14000000"/>
      <SolidColorBrush x:Key="LvBarTileInk" Color="#FF0F1E21"/>
      <SolidColorBrush x:Key="LvBarSunk" Color="#0D000000"/>
      <!-- the light accent: switches to Core's islands light (Accent.Tokens(hue, "light", "islands")) when
           native/r15-accent-v22 (look-sync v2.2's port) merges -->
      <SolidColorBrush x:Key="LvBarAccent" Color="#FF083F49"/>
      <SolidColorBrush x:Key="LvBarAccentHover" Color="#FF05313A"/>
      <SolidColorBrush x:Key="LvBarAccentInk" Color="#FFF4F7F8"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- gaps (DIP): island to window / screen edge and between big panels 12; a panel opens 12 above the bar; islands in a
       row 6; content edge = chrome edge 12 -->
  <x:Double x:Key="LvGap">12</x:Double>
  <Thickness x:Key="LvGapThickness">12</Thickness>
  <x:Double x:Key="LvGapAboveBar">12</x:Double>
  <x:Double x:Key="LvGapRow">6</x:Double>
  <x:Double x:Key="LvContentInset">12</x:Double>
  <Thickness x:Key="LvContentInsetThickness">12</Thickness>

  <!-- radii (DIP): controls 4 / 6 / 8; toolbar and tab islands 12; cards 16; pop-overs 14; a floating page 14; the big
       chart panel 20; pills and round buttons 999 (fully round). A nested shape: outer radius - gap. -->
  <x:Double x:Key="LvRadiusCtlS">4</x:Double>
  <CornerRadius x:Key="LvRadiusCtlSCorner">4</CornerRadius>
  <x:Double x:Key="LvRadiusCtlM">6</x:Double>
  <CornerRadius x:Key="LvRadiusCtlMCorner">6</CornerRadius>
  <x:Double x:Key="LvRadiusCtlL">8</x:Double>
  <CornerRadius x:Key="LvRadiusCtlLCorner">8</CornerRadius>
  <x:Double x:Key="LvIslandR">12</x:Double>
  <CornerRadius x:Key="LvIslandRCorner">12</CornerRadius>
  <x:Double x:Key="LvCardR">16</x:Double>
  <CornerRadius x:Key="LvCardRCorner">16</CornerRadius>
  <x:Double x:Key="LvPopoverR">14</x:Double>
  <CornerRadius x:Key="LvPopoverRCorner">14</CornerRadius>
  <x:Double x:Key="LvPageR">14</x:Double>
  <CornerRadius x:Key="LvPageRCorner">14</CornerRadius>
  <x:Double x:Key="LvChartR">20</x:Double>
  <CornerRadius x:Key="LvChartRCorner">20</CornerRadius>
  <x:Double x:Key="LvPillR">999</x:Double>
  <CornerRadius x:Key="LvPillRCorner">999</CornerRadius>

  <!-- the spacing grid 4 / 8 / 12 / 16 / 24 / 32; card padding 16 -->
  <x:Double x:Key="LvSpace4">4</x:Double>
  <x:Double x:Key="LvSpace8">8</x:Double>
  <x:Double x:Key="LvSpace12">12</x:Double>
  <x:Double x:Key="LvSpace16">16</x:Double>
  <x:Double x:Key="LvSpace24">24</x:Double>
  <x:Double x:Key="LvSpace32">32</x:Double>
  <x:Double x:Key="LvCardPadding">16</x:Double>
  <Thickness x:Key="LvCardPaddingThickness">16</Thickness>

  <!-- row heights: lists 32, menus 36, the tray 40; controls: toolbar buttons 32 (28 small), round controls 36 (28 small,
       44 main), pill buttons 28 tall -->
  <x:Double x:Key="LvRowList">32</x:Double>
  <x:Double x:Key="LvRowMenu">36</x:Double>
  <x:Double x:Key="LvRowTray">40</x:Double>
  <x:Double x:Key="LvToolbarButton">32</x:Double>
  <x:Double x:Key="LvToolbarButtonSmall">28</x:Double>
  <x:Double x:Key="LvRoundControl">36</x:Double>
  <x:Double x:Key="LvRoundControlSmall">28</x:Double>
  <x:Double x:Key="LvRoundControlMain">44</x:Double>
  <x:Double x:Key="LvPillHeight">28</x:Double>

  <!-- colours: text #EEF6F7; text-2 / -3 / -4 rgba(230,242,244,.76 / .54 / .34) (-4 disabled only); accent #A9E7ED with
       ink #052A2F on it (focus ring, active underline, selected); ok #8FE3B4; down #FF9D95; hair white .09 (dividers
       INSIDE an island only) -->
  <SolidColorBrush x:Key="LvText" Color="#FFEEF6F7"/>
  <SolidColorBrush x:Key="LvText2" Color="#C2E6F2F4"/>
  <SolidColorBrush x:Key="LvText3" Color="#8AE6F2F4"/>
  <SolidColorBrush x:Key="LvText4" Color="#57E6F2F4"/>
  <SolidColorBrush x:Key="LvAccent" Color="#FFA9E7ED"/>
  <SolidColorBrush x:Key="LvAccentInk" Color="#FF052A2F"/>
  <SolidColorBrush x:Key="LvOk" Color="#FF8FE3B4"/>
  <SolidColorBrush x:Key="LvDown" Color="#FFFF9D95"/>
  <SolidColorBrush x:Key="LvHair" Color="#17FFFFFF"/>

  <!-- control fills inside an island: white at .00 / .07 / .12 / .18, pressed .05 -->
  <SolidColorBrush x:Key="LvCtlFillRest" Color="#00FFFFFF"/>
  <SolidColorBrush x:Key="LvCtlFillHover" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="LvCtlFillOn" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="LvCtlFillStrong" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="LvCtlFillPressed" Color="#0DFFFFFF"/>

  <!-- the island's white sheen, on HOVER only (none at rest): .07, big panels .05 -->
  <SolidColorBrush x:Key="LvSheenHover" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="LvSheenHoverBig" Color="#0DFFFFFF"/>

  <!-- focus: one ring everywhere, 2 px accent, offset 2 (a focused input island gets the ring round the island) -->
  <x:Double x:Key="LvFocusRingWidth">2</x:Double>
  <Thickness x:Key="LvFocusRingThickness">2</Thickness>
  <x:Double x:Key="LvFocusRingOffset">2</x:Double>

  <!-- type: Segoe UI Variable Text for UI, Display for big numbers (weights 400 / 500 / 600, 300 only on a hero clock;
       tabular figures on every number that changes) -->
  <FontFamily x:Key="LvFontText">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="LvFontDisplay">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>

  <!-- the flat fill until the blurred still is ready (or when it fails): #2c5258, still legible -->
  <SolidColorBrush x:Key="LvFallback" Color="#FF2C5258"/>

  <!-- motion (transform and opacity only): curves as "x1,y1,x2,y2" (Tokens.xaml's *Bezier strings), timings in ms -->
  <x:String x:Key="LvEaseBezier">0.2,0.8,0.2,1</x:String>
  <x:String x:Key="LvEaseLiftBezier">0.22,1.12,0.36,1</x:String>
  <x:String x:Key="LvEaseMorphBezier">0.22,1,0.36,1</x:String>
  <x:Double x:Key="LvDurMs">160</x:Double>
  <x:Double x:Key="LvDurSlowMs">340</x:Double>
  <x:Double x:Key="LvSlideMs">320</x:Double>
  <x:Double x:Key="LvPressScaleSmall">0.94</x:Double>
  <x:Double x:Key="LvPressScalePill">0.97</x:Double>
  <x:Double x:Key="LvPressScaleTile">0.985</x:Double>
</ResourceDictionary>
