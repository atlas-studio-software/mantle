<?xml version="1.0" encoding="utf-8"?>
<!--
  The ONE theme entry point (PLAN.md decision A9 and section 3.8). App.xaml merges this file once and
  never changes for theme work again: everything the theme adds (Tokens.xaml generated from
  docs/theme-tokens.md, materials, motion, type, focus rings) is merged HERE, by the lane that owns
  Mantle.App/Theme/**. No resources of its own.

  Code that looks a token up by hand (BarWindow.ThemeToken) searches nested merged dictionaries, so a
  token may live in any file merged below.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
