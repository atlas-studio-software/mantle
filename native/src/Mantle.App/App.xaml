<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Mantle.App.MantleApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The stock control styles. The idle bar uses none of them, but the real bar has
             tooltips, menus and flyouts, so they are loaded to keep the RAM number honest. -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
        <!-- The theme, merged once: Theme/Theme.xaml merges every theme file (Tokens.xaml, ...). -->
        <ResourceDictionary Source="Theme/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
