<?xml version="1.0" encoding="utf-8"?>
<!--
  The bar at rest, laid out like ui/bar/index.html + bar.css (all sizes in DIP = CSS px):
  a 48 tall island, padding 0 8, gap 8; left = the Mantle mark (38 x 36); the dock centred on the
  whole island (36 cells, 6 apart, 24 icons, a 3 px running line under each); right = separator,
  downloads, volume, network, clock (two lines, min 80 wide), notifications, more (36 wide each, 4 apart).
  The island is three layers like .bar / .bdrop / .bar::after: the blurred backdrop picture, the tint
  with its 1 px hairline, and the 1 px white lip inside the top edge.
-->
<Window
    x:Class="Mantle.App.BarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mantle.App"
    Title="Mantle bar">
  <local:UiaGrid x:Name="Root" AutomationProperties.AutomationId="bar.window" AutomationProperties.Name="Mantle bar">
    <local:UiaGrid.Resources>
      <Style x:Key="LgBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource LgInk2}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters><Setter Target="Face.Background" Value="{ThemeResource LgHover}"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters><Setter Target="Face.Background" Value="{ThemeResource LgPress}"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </local:UiaGrid.Resources>

    <!-- the light theme's drop shadow lives here, as composition visuals (BarWindow.xaml.cs) -->
    <Canvas x:Name="ShadowHost" IsHitTestVisible="False"/>

    <local:UiaGrid x:Name="Pill" AutomationProperties.AutomationId="bar.pill" AutomationProperties.Name="Mantle bar" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border x:Name="Glass" CornerRadius="{ThemeResource LgPillCorner}">
        <Border.Background><ImageBrush x:Name="GlassImage" Stretch="Fill"/></Border.Background>
      </Border>
      <!-- the fill runs under the hairline (bar.css .bar::after: background-clip: border-box), and the
           hairline is its own background-less layer on top: a Border with both a Background and a
           translucent BorderBrush drew the hairline nearly opaque on the runner (spike run 1) -->
      <Border x:Name="Tint" CornerRadius="{ThemeResource LgPillCorner}" Background="{ThemeResource LgPaneFill}"/>
      <Border x:Name="Lip" Margin="1" CornerRadius="{ThemeResource LgLipCorner}" BorderBrush="{ThemeResource LgLip}"
              BorderThickness="0,1,0,0"/>
      <Border x:Name="Edge" CornerRadius="{ThemeResource LgPillCorner}" BorderBrush="{ThemeResource LgEdgeOut}" BorderThickness="1"/>

      <Grid x:Name="Content" Padding="8,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="StartBtn" AutomationProperties.AutomationId="bar.start" AutomationProperties.Name="Start" Grid.Column="0" Style="{StaticResource LgBtn}" Width="38"
                ToolTipService.ToolTip="Open the Mantle launcher">
          <Viewbox Width="22" Height="22"><Canvas x:Name="MarkHost" Width="24" Height="24"/></Viewbox>
        </Button>

        <!-- RightCluster / NotifsBtn: named for lane native-r7-notif (the tray strip goes in first; the bell) -->
        <StackPanel x:Name="RightCluster" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Rectangle Width="1" Height="20" Fill="{ThemeResource LgEdgeOut}" VerticalAlignment="Center"/>
          <Button x:Name="DownloadsBtn" AutomationProperties.AutomationId="bar.downloads" AutomationProperties.Name="Downloads" Style="{StaticResource LgBtn}" Width="36"><Canvas x:Name="DownloadsHost" Width="16" Height="16"/></Button>
          <Button x:Name="VolumeBtn" AutomationProperties.AutomationId="bar.volume" AutomationProperties.Name="Volume" Style="{StaticResource LgBtn}" Width="36"><Canvas x:Name="VolumeHost" Width="16" Height="16"/></Button>
          <Button x:Name="NetworkBtn" AutomationProperties.AutomationId="bar.network" AutomationProperties.Name="Network" Style="{StaticResource LgBtn}" Width="36"><Canvas x:Name="NetworkHost" Width="16" Height="16"/></Button>
          <!-- Electron's battery button while it is hidden: .btn's display:flex beats [hidden], so with no battery it
               still takes 14 px (.battery: width auto, padding 0 7px) + the 4 px gap. Kept so the cluster sits where
               Electron's does (the parity known gap "right-cluster"); the battery itself (glyph + percent) is round 3. -->
          <Button x:Name="BatteryBtn" AutomationProperties.AutomationId="bar.battery" AutomationProperties.Name="Battery" Style="{StaticResource LgBtn}" Width="14" IsTabStop="False"/>
          <Button x:Name="ClockBtn" AutomationProperties.AutomationId="bar.clock" AutomationProperties.Name="Clock" Style="{StaticResource LgBtn}" Padding="9,0,9,0" MinWidth="62">
            <StackPanel Spacing="2" HorizontalAlignment="Right">
              <TextBlock x:Name="ClockT" AutomationProperties.AutomationId="bar.clock.time" FontSize="13" MinWidth="80" TextAlignment="Right" HorizontalAlignment="Right"
                         Foreground="{ThemeResource LgInk}" FontFamily="{StaticResource LgFont}"
                         LineHeight="13" LineStackingStrategy="BlockLineHeight" Text="--:--"/>
              <TextBlock x:Name="ClockD" AutomationProperties.AutomationId="bar.clock.date" FontSize="{ThemeResource LgDateSize}" TextAlignment="Right" HorizontalAlignment="Right"
                         Foreground="{ThemeResource LgInk2}" FontFamily="{StaticResource LgFont}"
                         LineHeight="13" LineStackingStrategy="BlockLineHeight" Text="--"/>
            </StackPanel>
          </Button>
          <Button x:Name="NotifsBtn" AutomationProperties.AutomationId="bar.notifications" AutomationProperties.Name="Notifications" Style="{StaticResource LgBtn}" Width="36"><Canvas x:Name="NotifsHost" Width="16" Height="16"/></Button>
          <Button x:Name="MoreBtn" AutomationProperties.AutomationId="bar.more" AutomationProperties.Name="More" Style="{StaticResource LgBtn}" Width="36">
            <!-- bar.css .more .mpip: one pip for every chip, 6 px at top 7 / right 7, a 2 px ring of the fill behind it -->
            <Grid Width="36" Height="36">
              <Canvas x:Name="MoreHost" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <local:UiaGrid x:Name="MorePip" AutomationProperties.AutomationId="bar.more.pip" AutomationProperties.Name="More pip" Visibility="Collapsed" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" IsHitTestVisible="False">
                <Ellipse x:Name="MorePipRing" Width="10" Height="10"/>
                <Ellipse x:Name="MorePipDot" Width="6" Height="6" Fill="{ThemeResource LgInk2}"/>
              </local:UiaGrid>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>

      <!-- .dock: centred on the whole island, not between the clusters; slid off centre and "+N" by the fit rule (BarWindow.Overflow.cs) -->
      <StackPanel x:Name="DockRow" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel.RenderTransform><TranslateTransform x:Name="DockShift"/></StackPanel.RenderTransform>
      <local:UiaItemsControl x:Name="Dock" AutomationProperties.AutomationId="bar.apps" AutomationProperties.Name="Running apps" VerticalAlignment="Center" IsTabStop="False">
        <local:UiaItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
        </local:UiaItemsControl.ItemsPanel>
        <local:UiaItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:CellVm">
            <!-- bar.js renderDock / bar.css .dock .div: a 1x22 hairline, 3 px each side, before the first running-only app -->
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="1" Height="22" Margin="3,0,9,0" VerticalAlignment="Center" Fill="{ThemeResource LgEdgeOut}"
                         Visibility="{x:Bind DividerVisibility, Mode=OneWay}"/>
              <Button Style="{StaticResource LgBtn}" Width="36" Click="Cell_Click" Loaded="Cell_Loaded" Tag="{x:Bind}"
                      AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind ExeName, Mode=OneWay}"
                      AutomationProperties.ItemStatus="{x:Bind Status, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
                <Grid>
                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid Width="24" Height="24" CornerRadius="6">
                    <Border Background="{ThemeResource LgTile}" Visibility="{x:Bind TileVisibility, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Letter, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" CharacterSpacing="20"
                                 Foreground="{ThemeResource LgInk}" FontFamily="{StaticResource LgFont}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Visibility="{x:Bind IconVisibility, Mode=OneWay}"/>
                  </Grid>
                  <!-- .cell .ind: laid out for every cell (hidden, not absent) so an icon never shifts when an app opens -->
                  <Grid Height="3" Width="16">
                    <Border Width="6" Height="3" CornerRadius="1.5" Background="{ThemeResource LgInk2}"
                            HorizontalAlignment="Center" Visibility="{x:Bind RunVisibility, Mode=OneWay}"/>
                    <Border Width="16" Height="3" CornerRadius="1.5" Background="{ThemeResource LgAcc}"
                            HorizontalAlignment="Center" Visibility="{x:Bind ActVisibility, Mode=OneWay}"/>
                  </Grid>
                </StackPanel>
                <!-- r7-strip, ui/bar/jumplist.css .cell .ontop-badge: a 13 DIP accent disc with a pin, top-right, while Mantle keeps one of its windows on top -->
                <Border Width="13" Height="13" CornerRadius="6.5" Margin="0,-3,-9,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{ThemeResource LgAcc}" BorderBrush="{ThemeResource LgFillStrong}" BorderThickness="1.5"
                        Visibility="{x:Bind OnTopVisibility, Mode=OneWay}">
                  <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="7" Foreground="{ThemeResource LgAccOn}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- media4, ui/bar/helmbadge.css .hb-badge: the app's count (Helm: chats that need the user), accent, warn when one stopped on an error -->
                <Border MinWidth="15" Height="15" CornerRadius="7.5" Padding="{x:Bind BadgePad, Mode=OneWay}" Margin="0,-2,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{ThemeResource LgAcc}" BorderBrush="{ThemeResource LgFillStrong}" BorderThickness="1.5" Visibility="{x:Bind BadgeAccVisibility, Mode=OneWay}">
                  <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource LgAccOn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border MinWidth="15" Height="15" CornerRadius="7.5" Padding="{x:Bind BadgePad, Mode=OneWay}" Margin="0,-2,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{ThemeResource LgWarn}" BorderBrush="{ThemeResource LgFillStrong}" BorderThickness="1.5" Visibility="{x:Bind BadgeWarnVisibility, Mode=OneWay}">
                  <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource LgAccOn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                </Grid>
              </Button>
            </StackPanel>
          </DataTemplate>
        </local:UiaItemsControl.ItemTemplate>
      </local:UiaItemsControl>
      <!-- bar.css .dmore: the "+N" button, the strip's last child, for the apps that do not fit (BAR-235) -->
      <Button x:Name="DockMore" AutomationProperties.AutomationId="bar.apps.more" Style="{StaticResource LgBtn}" Width="36" Height="36" Visibility="Collapsed"
              Background="{ThemeResource LgSunk}" Foreground="{ThemeResource LgInk2}" FontSize="12.5" FontWeight="SemiBold" FontFamily="{StaticResource LgFont}"/>
      </StackPanel>
    </local:UiaGrid>
  </local:UiaGrid>
</Window>
