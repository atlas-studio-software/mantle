<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mantle bar, native spike (C# + WinUI 3). A prototype for one decision: should the bar move off
    Electron? It draws only what the real bar shows at rest (ui/bar): the inset pill, the running
    apps with their real icons (click = focus), the right-hand glyphs and the clock. No flyouts.

    Built with the plain .NET SDK (dotnet publish), unpackaged, with the Windows App SDK runtime
    carried inside the output folder (self-contained), so nothing has to be installed to run it.
    SpikeTfm lets the bench pick the newest SDK the machine has.
  -->
  <PropertyGroup>
    <SpikeTfm Condition="'$(SpikeTfm)' == ''">net10.0</SpikeTfm>
    <TargetFramework>$(SpikeTfm)-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MantleBar</RootNamespace>
    <AssemblyName>MantleBar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
</Project>
