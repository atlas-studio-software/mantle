<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mantle, native (C# + WinUI 3). The first surface is the bar, from the spike (spike/winui-bar,
    native-spike/README.md): the inset pill, the running apps with their real icons (click = focus),
    the right-hand glyphs and the clock. No flyouts yet.

    The exe is MantleNative.exe, never electron.exe or Mantle.exe, so nothing confuses it with the
    Electron shell's processes. Built with the plain .NET SDK, unpackaged, with the Windows App SDK
    runtime carried inside the output folder (self-contained), so nothing has to be installed to run
    it. native/tools/publish.ps1 builds the three publish modes (sc, fd, aot).

    The XAML-generated Main is off (DISABLE_XAML_GENERATED_MAIN): Program.cs parses the arguments,
    opens the log and takes the single-instance claim BEFORE any XAML loads, so a second launch
    hands off and exits without creating a window.
  -->
  <PropertyGroup>
    <TargetFramework>$(MantleWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(MantleWindowsMinVersion)</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Mantle.App</RootNamespace>
    <AssemblyName>MantleNative</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- trim/AOT analysis warnings show in every build, so a reflection-heavy pattern is seen early -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!--
      Native AOT is what CI tests and what ships (native/tools/publish.ps1 -Mode aot; bench/README.md has the
      numbers). Under AOT a trim or CsWinRT warning is a crash or a silent no-op at run time, so these are
      build errors in every build, not only in the AOT publish: CsWinRT1028 = a class that implements a WinRT
      interface (e.g. derives from a WinUI type) without `partial` (no AOT vtable: the app dies at start);
      IL2xxx = reflection the trimmer cannot follow; IL3050/IL3051 = code that needs the JIT.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CsWinRT1028;CsWinRT1030;IL2026;IL2046;IL2050;IL2057;IL2059;IL2060;IL2062;IL2065;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2088;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2104;IL2111;IL3050;IL3051;IL3053</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MantleWinAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(MantleWindowsSdkBuildToolsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mantle.Core\Mantle.Core.csproj" />
    <!-- the [Command]/[Feature]/[Surface] catalogs (Mantle.Generators); compile-time only, never shipped -->
    <ProjectReference Include="..\Mantle.Generators\Mantle.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;PublishReadyToRun;PublishSingleFile;WindowsAppSDKSelfContained;Platform" />
  </ItemGroup>
  <ItemGroup>
    <None Include="AUTOMATION.md" />
  </ItemGroup>
</Project>
