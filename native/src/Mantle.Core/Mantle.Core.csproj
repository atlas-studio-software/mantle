<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mantle.Core: everything the native app needs that is not UI, so it can be unit tested without a
    window: the command line, where the data lives, the single-instance claim, the log, and the
    READ-ONLY readers of the files Electron Mantle writes (DATA.md lists them).

    Plain net10.0 (no Windows TFM): nothing here needs the WinRT projection. IsAotCompatible turns
    on the trim, AOT and single-file analyzers, and JSON goes through JsonDocument (readers) and a
    source-generated context (the hand-off message), never reflection.
  -->
  <PropertyGroup>
    <TargetFramework>$(MantleTfm)</TargetFramework>
    <RootNamespace>Mantle.Core</RootNamespace>
    <AssemblyName>Mantle.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mantle.Core.Tests" />
    <None Include="DATA.md" />
  </ItemGroup>
</Project>
